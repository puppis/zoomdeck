{
  // Ctrl+B / ⌘B exports one HTML file next to the deck; the variants start the preview server
  // or write the static folder export. The `zoomdeck_exec` target (zoomdeck.py in this package)
  // runs the command with the PATH of your login shell, so it is found even when Sublime Text
  // was started from the Dock or a launcher. The command name lives in Zoomdeck.sublime-settings.
  "target": "zoomdeck_exec",
  "cancel": { "kill": true },
  "selector": "text.html.markdown, source.json",
  "working_dir": "$file_path",
  "cmd": ["zoomdeck", "build", "$file", "-o", "$file_path/build", "--one-file"],
  "variants": [
    { "name": "Preview", "cmd": ["zoomdeck", "serve", "$file"] },
    { "name": "Build folder", "cmd": ["zoomdeck", "build", "$file", "-o", "$file_path/build"] }
  ]
}
