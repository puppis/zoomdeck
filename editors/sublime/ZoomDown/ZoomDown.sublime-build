{
  // Ctrl+B / ⌘B exports one HTML file next to the deck; the variants start the preview server
  // or write the static folder export. The `zoomdown_exec` target (zoomdown.py in this package)
  // runs the command with the PATH of your login shell, so it is found even when Sublime Text
  // was started from the Dock or a launcher, and adds `--editor` to the preview so that E or
  // Alt+click in the browser opens the source line here. The command name lives in
  // ZoomDown.sublime-settings.
  "target": "zoomdown_exec",
  "cancel": { "kill": true },
  "selector": "text.html.markdown.zoomdown",
  "working_dir": "$file_path",
  "cmd": ["zoomdown", "build", "$file", "-o", "$file_path/build", "--one-file"],
  "variants": [
    { "name": "Preview", "cmd": ["zoomdown", "serve", "$file"] },
    { "name": "Build folder", "cmd": ["zoomdown", "build", "$file", "-o", "$file_path/build"] }
  ]
}
