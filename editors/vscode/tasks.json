{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zoomdeck: preview",
      "detail": "Serve the deck of the current file; the browser reloads on every save and keeps its position.",
      "type": "shell",
      "command": "zoomdeck serve \"${file}\"",
      "options": { "cwd": "${fileDirname}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Zoomdeck: build HTML",
      "detail": "Export the deck of the current file as one self-contained HTML file in ./build.",
      "type": "shell",
      "command": "zoomdeck build \"${file}\" -o \"${fileDirname}/build\" --one-file",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
