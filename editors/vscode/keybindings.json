[
  {
    "key": "ctrl+alt+b",
    "mac": "cmd+alt+b",
    "command": "workbench.action.tasks.runTask",
    "args": "ZoomDown: preview",
    "when": "editorLangId == markdown"
  },
  {
    "key": "ctrl+alt+j",
    "mac": "cmd+alt+j",
    "command": "workbench.action.tasks.runTask",
    "args": "ZoomDown: jump to this line",
    "when": "editorLangId == markdown"
  },
  {
    "key": "ctrl+alt+p",
    "mac": "cmd+alt+p",
    "command": "workbench.action.tasks.runTask",
    "args": "ZoomDown: build HTML",
    "when": "editorLangId == markdown"
  }
]
