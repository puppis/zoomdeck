{
  "scopeName": "markdown.zoomdeck.injection",
  "injectionSelector": "L:text.html.markdown - (markup.fenced_code | markup.raw)",
  "patterns": [
    { "include": "#container" },
    { "include": "#directive" },
    { "include": "#trailing-attributes" }
  ],
  "repository": {
    "container": {
      "match": "^\\s*(:::)\\s*(slide|styles)?\\s*(\\{[^}]*\\})?\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.block.zoomdeck" },
        "2": { "name": "keyword.control.container.zoomdeck" },
        "3": { "patterns": [{ "include": "#attributes" }] }
      }
    },
    "directive": {
      "match": "^\\s*(\\[\\[)([a-z_]+)(:)(.*?)(\\]\\])\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.directive.zoomdeck" },
        "2": { "name": "keyword.control.directive.zoomdeck" },
        "3": { "name": "punctuation.separator.zoomdeck" },
        "4": { "patterns": [{ "include": "#attributes" }] },
        "5": { "name": "punctuation.definition.directive.zoomdeck" }
      }
    },
    "trailing-attributes": {
      "match": "(\\{[^{}\\n]*\\})\\s*$",
      "captures": { "1": { "patterns": [{ "include": "#attributes" }] } }
    },
    "attributes": {
      "patterns": [
        { "match": "\"[^\"]*\"|'[^']*'", "name": "string.quoted.zoomdeck" },
        { "match": "#[A-Za-z_][\\w.-]*", "name": "entity.name.tag.id.zoomdeck" },
        { "match": "\\.[A-Za-z_][\\w-]*", "name": "entity.other.attribute-name.class.zoomdeck" },
        { "match": "->", "name": "keyword.operator.arrow.zoomdeck" },
        { "match": "([A-Za-z_][\\w-]*)(=|:)", "captures": { "1": { "name": "variable.parameter.zoomdeck" }, "2": { "name": "keyword.operator.assignment.zoomdeck" } } },
        { "match": "-?\\d+(\\.\\d+)?", "name": "constant.numeric.zoomdeck" },
        { "match": "\\((-?\\d*\\.?\\d+),\\s*(-?\\d*\\.?\\d+)\\)", "name": "constant.other.point.zoomdeck" }
      ]
    }
  }
}
