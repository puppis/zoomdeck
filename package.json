{
  "name": "zoomdown",
  "version": "0.6.12",
  "description": "Zooming presentations written in Markdown and played entirely in the browser: a tree of slides visited in pre-order with a zooming camera.",
  "keywords": [
    "presentation",
    "slides",
    "zooming",
    "markdown",
    "latex",
    "webgl",
    "manim",
    "hand-drawn",
    "rough"
  ],
  "author": "Gabriele Puppis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppis/zoomdown.git"
  },
  "homepage": "https://puppis.github.io/zoomdown/",
  "bugs": {
    "url": "https://github.com/puppis/zoomdown/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "zoomdown": "./bin/zoomdown.mjs"
  },
  "main": "./dist/zoomdown.js",
  "module": "./dist/zoomdown.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/zoomdown.js",
      "default": "./dist/zoomdown.js"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/patches.ts",
    "*.css"
  ],
  "files": [
    "bin",
    "dist",
    "src",
    "scripts/check-node.mjs",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "docs/markup.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node bin/zoomdown.mjs serve",
    "build:standalone": "vite build --config vite.bundle.config.ts",
    "docs": "npm run build:standalone && vite-node scripts/build-docs.ts",
    "docs:lite": "python docs/lite/build-wheel.py && jupyter lite build --lite-dir docs/lite --output-dir docs/html/lite",
    "prepare": "npm run docs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "desktop": "electron desktop/main.mjs",
    "desktop:dir": "electron-builder --dir",
    "desktop:build": "electron-builder --publish never"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "manim-web": "^0.41.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "roughjs": "^4.6.6",
    "three": "^0.186.1",
    "vite": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "mystmd": "^1.13.0",
    "typescript": "^5.9.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "io.github.puppis.zoomdown",
    "productName": "ZoomDown",
    "copyright": "MIT License",
    "asar": false,
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "files": [
      "desktop/**/*",
      "bin/**/*",
      "src/**/*",
      "examples/tour/**/*",
      "index.html",
      "pad.html",
      "tsconfig.json",
      "package.json",
      "!examples/tour/recordings/**",
      "!examples/tour/build/**",
      "!desktop/sign.mjs",
      "!**/*.map"
    ],
    "afterPack": "desktop/sign.mjs",
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "zd",
        "name": "ZoomDown deck",
        "description": "ZoomDown deck",
        "mimeType": "text/x-zoomdown",
        "role": "Viewer",
        "rank": "Owner"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "ZoomDown shows and records your camera while you present, when you turn it on.",
        "NSMicrophoneUsageDescription": "ZoomDown records your voice when you record a talk.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "io.github.puppis.zoomdown.deck",
            "UTTypeDescription": "ZoomDown deck",
            "UTTypeConformsTo": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "zd"
              ],
              "public.mime-type": [
                "text/x-zoomdown"
              ]
            }
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Gabriele Puppis"
    },
    "publish": {
      "provider": "github",
      "owner": "puppis",
      "repo": "zoomdown"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1",
      "@electron/asar": {
        "minimatch": "^3.0.4"
      },
      "electron-builder-squirrel-windows": {
        "minimatch": "^3.1.1"
      },
      "ejs": {
        "minimatch": "^5.0.1"
      },
      "@electron/universal": {
        "minimatch": "^11.0.1",
        "dir-compare": {
          "minimatch": "^3.0.5"
        }
      }
    }
  }
}
