{
  "name": "zoomdeck",
  "version": "0.1.0",
  "description": "Zooming presentations written in Markdown and played entirely in the browser: a tree of slides visited in pre-order with a zooming camera.",
  "keywords": [
    "presentation",
    "slides",
    "zooming",
    "markdown",
    "latex",
    "webgl",
    "manim",
    "hand-drawn",
    "rough"
  ],
  "author": "Gabriele Puppis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppis/zoomdeck.git"
  },
  "homepage": "https://puppis.github.io/zoomdeck/",
  "bugs": {
    "url": "https://github.com/puppis/zoomdeck/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "zoomdeck": "./bin/zoomdeck.mjs"
  },
  "main": "./dist/zoomdeck.js",
  "module": "./dist/zoomdeck.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/zoomdeck.js",
      "default": "./dist/zoomdeck.js"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/patches.ts",
    "*.css"
  ],
  "files": [
    "bin",
    "dist",
    "src",
    "scripts/check-node.mjs",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "docs/markup.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node bin/zoomdeck.mjs serve",
    "docs": "vite-node scripts/build-docs.ts",
    "prepare": "npm run docs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "desktop": "electron desktop/main.mjs",
    "desktop:dir": "electron-builder --dir",
    "desktop:build": "electron-builder --publish never"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "manim-web": "^0.41.0",
    "markdown-it": "^14.1.0",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "roughjs": "^4.6.6",
    "three": "^0.186.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "happy-dom": "^18.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "io.github.puppis.zoomdeck",
    "productName": "Zoomdeck",
    "copyright": "MIT License",
    "asar": false,
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "files": [
      "desktop/**/*",
      "bin/**/*",
      "src/**/*",
      "examples/guide/**/*",
      "index.html",
      "pad.html",
      "tsconfig.json",
      "package.json",
      "!examples/guide/recordings/**",
      "!examples/guide/build/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Zoomdeck shows and records your camera while you present, when you turn it on.",
        "NSMicrophoneUsageDescription": "Zoomdeck records your voice when you record a talk."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Gabriele Puppis"
    },
    "publish": {
      "provider": "github",
      "owner": "puppis",
      "repo": "zoomdeck"
    }
  }
}
